//------------------------------------------------
//--- 010 Editor v14.0 Binary Template
//
//      File: SL2
//   Authors: ClayAmore, er-save-manager
//   Version: 2.0
//   Purpose: Reading an Elden Ring save file (PC .sl2/.co2, PlayStation memory.dat)
//  Category: Game
// File Mask: *.sl2;*.co2;memory.dat
//  ID Bytes:
//   History: 2.0 - PlayStation layout, field names and layouts from
//                  er-save-manager docs/technical/save-file-structure.md,
//                  decoded world state blocks, NetMan, menu data, presets,
//                  key config; hash checks report instead of asserting.
//------------------------------------------------

// Event flag bytes: the lowest flag of a byte is the most significant bit.
BitfieldLeftToRight();

local enum Boolean {
    False = 0,
    True = 1
};

// Coordinates
typedef struct {
    float X;
    float Y;
    float Z;
} FloatVector3 <read=Str("(%.1f, %.1f, %.1f)", X, Y, Z)>;

// Angle
typedef struct {
    float X;
    float Y;
    float Z;
    float W;
} FloatVector4 <read=Str("(%.1f, %.1f, %.1f, %.1f)", X, Y, Z, W)>;

// MapId: bytes [DD CC BB AA] name map mAA_BB_CC_DD
typedef ubyte M[4] <read=Str("m%02d_%02d_%02d_%02d",this[3],this[2],this[1],this[0])>;

// Map name of the MapId stored at pos
string MapIdAt(int64 pos) {
    return Str("m%02d_%02d_%02d_%02d", ReadUByte(pos + 3), ReadUByte(pos + 2), ReadUByte(pos + 1), ReadUByte(pos));
}

//------------------------------------------------
// PlayerGameDataHash helpers
//------------------------------------------------

// Adler-like checksum: lo/hi mod 0xFFF1, result (lo | hi << 16) * 2
uint ComputeHashedValue(uint input) {
    local uint64 product = (uint64)0x80078071 * (uint64)input;
    local uint32 upper_bits = (uint32)(product >> 32);
    local uint32 shifted_upper_bits = upper_bits >> 15;
    local uint32 mod_product = (uint32)((int32)shifted_upper_bits * (-0xfff1));
    return input + mod_product;
}

uint BytesHash(ubyte bytes[], int size) {
    local int i = 0;
    local uint lo = 1;
    local uint hi = 0;
    while (i < size) {
        lo = lo + (bytes[i] & 0xFF);
        hi = hi + lo;
        i = i + 1;
    }
    return (ComputeHashedValue(lo) | (ComputeHashedValue(hi) << 0x10)) * 2;
}

uint ValueHash(uint value) {
    local ubyte buffer[0x4];
    ConvertDataToBytes(value, buffer);
    return BytesHash(buffer, 0x4);
}

uint WordsHash(uint words[], int count) {
    local ubyte buffer[count * 4];
    local int i = 0;
    while (i < count) {
        buffer[i * 4]     = words[i] & 0xFF;
        buffer[i * 4 + 1] = (words[i] >> 8) & 0xFF;
        buffer[i * 4 + 2] = (words[i] >> 16) & 0xFF;
        buffer[i * 4 + 3] = (words[i] >> 24) & 0xFF;
        i = i + 1;
    }
    return BytesHash(buffer, count * 4);
}

//------------------------------------------------
// Gaitem map
//------------------------------------------------

// Handle bits: 28-31 category (0x8 weapon, 0x9 armor, 0xC Ash of War),
// 16-23 generation, 0-15 index into the game's gaitem array (below 0x1400).
// Entry size: 8 bytes for empty and 0xC handles, 16 otherwise, 21 for weapons.
typedef struct Item {
    uint32 GaitemHandle<format=hex>;
    uint32 ItemID<format=hex>;
    if (GaitemHandle != 0 && (GaitemHandle & 0xF0000000) != 0xC0000000) {
        int32 unk0x10;
        int32 unk0x14;
        // Weapon: id = base + upgrade, affinity = (id / 100) % 100
        if ((GaitemHandle & 0xF0000000) == 0x80000000) {
            // Handle of the Ash of War's own 0xC entry
            uint32 AOWGaitemHandle<format=hex>;
            ubyte unk0x1c;
        }
    }
};

//------------------------------------------------
// PlayerGameData (CS::PlayerGameData + 0x8, 0x1B0 bytes)
//------------------------------------------------
typedef struct {
    uint32 unk0x0 <hidden = true>;
    uint32 unk0x4 <hidden = true>;
    uint32 Health;
    uint32 MaxHealth;
    uint32 BaseMaxHealth;
    uint32 FP;
    uint32 MaxFP;
    uint32 BaseMaxFP;
    uint32 unk0x20 <hidden = true>;
    uint32 SP;
    uint32 MaxSP;
    uint32 BaseMaxSP;
    uint32 unk0x30 <hidden = true>;
    uint32 Vigor;
    uint32 Mind;
    uint32 Endurance;
    uint32 Strength;
    uint32 Dexterity;
    uint32 Intelligence;
    uint32 Faith;
    uint32 Arcane;
    uint32 unk0x54;                 // part of hash entry 1
    uint32 unk0x58 <hidden = true>;
    uint32 Humanity;                // always 0
    uint32 Level;
    uint32 Runes;
    uint32 RunesMemory;             // total runes ever gained
    uint32 unk0x6c <hidden = true>;
    uint32 PoisonBuildUp;
    uint32 RotBuildUp;
    uint32 BleedBuildUp;
    uint32 DeathBuildUp;
    uint32 FrostBuildUp;
    uint32 SleepBuildUp;
    uint32 MadnessBuildUp;
    uint32 unk0x8c;
    uint32 CharacterType;           // always 0
    wchar_t CharacterName[0x10];
    uint16 CharacterNameTerminator <hidden = true>;
    ubyte BodyType;
    ubyte ArcheType;                // starting class (CharaInitParam row)
    ubyte unk0xb8;                  // hash entry 3
    ubyte unk0xb9;
    ubyte VoiceType;
    ubyte Gift;                     // starting keepsake
    ubyte unk0xbc;
    ubyte MemoryStoneCount;         // Memory Stones used, 0-8
    ubyte AdditionalTalismanSlotsCount;
    ubyte SummonSpiritLevel;        // spirit ash upgrade level
    uint32 OnlineSessionCount;      // +1 per co-op host, summoned phantom or invasion
    uint32 unk0xc4;                 // counter, grows with play time
    ubyte unk0xc8[0x10];
    ubyte FurlCallingFingerOn;
    ubyte unk0xd9;
    ubyte MatchmakingWeaponLvl;     // highest weapon upgrade reached
    ubyte WhiteCipherRingOn;
    ubyte BlueCipherRingOn;
    ubyte unk0xdd[0x17];
    ubyte ScadutreeBlessing;        // 0-20
    ubyte ReveredSpiritAshBlessing; // 0-10
    ubyte unk0xf6;
    ubyte GreatRuneOn;              // Rune Arc used; cleared on death
    ubyte unk0xf8;
    ubyte MaxCrimsonFlaskCount;
    ubyte MaxCeruleanFlaskCount;
    ubyte unk0xfb[0xD];
    // Written when the character leaves for another world (summoned or invading)
    uint32 SavedHP;
    uint32 SavedFP;
    wchar_t Password[0x8];
    uint16 PasswordTerminator <hidden = true>;
    wchar_t GroupPassword1[0x8];
    uint16 GroupPassword1Terminator <hidden = true>;
    wchar_t GroupPassword2[0x8];
    uint16 GroupPassword2Terminator <hidden = true>;
    wchar_t GroupPassword3[0x8];
    uint16 GroupPassword3Terminator <hidden = true>;
    wchar_t GroupPassword4[0x8];
    uint16 GroupPassword4Terminator <hidden = true>;
    wchar_t GroupPassword5[0x8];
    uint16 GroupPassword5Terminator <hidden = true>;
    ubyte SavedCrimsonCharges;      // changes together with SavedHP
    ubyte SavedCeruleanCharges;
    ubyte SavedStateFlag;
    ubyte unk0x17f;
    uint32 unk0x180;
    uint32 unk0x184;
    ubyte unk0x188[0x28];
} PlayerGameData;

// SpEffect (16 bytes); active when SPEffectID != 0 and RemainingTime > 0
typedef struct {
    int32 SPEffectID;
    float RemainingTime;
    uint32 unk0x8;
    uint32 unk0xc;
} SPEffects;

// Equipment slots (0x58). Three parallel copies: equip index, item id, gaitem handle
typedef struct {
    uint32 LeftHandArmament1;
    uint32 RightHandArmament1;
    uint32 LeftHandArmament2;
    uint32 RightHandArmament2;
    uint32 LeftHandArmament3;
    uint32 RightHandArmament3;
    uint32 Arrows1;
    uint32 Bolts1;
    uint32 Arrows2;
    uint32 Bolts2;
    uint32 Arrows3 <hidden = true>;     // unused
    uint32 Bolts3 <hidden = true>;      // unused
    uint32 Head;
    uint32 Chest;
    uint32 Arms;
    uint32 Legs;
    uint32 Hair <hidden = true>;        // unused
    uint32 Talisman1;
    uint32 Talisman2;
    uint32 Talisman3;
    uint32 Talisman4;
    uint32 Talisman5 <hidden = true>;   // unused
} ChrAsmEquipment;

// ChrAsm + 0x4 (0x1C)
typedef struct {
    uint32 ArmStyle;
    uint32 LeftHandWeaponActiveSlot;
    uint32 RightHandWeaponActiveSlot;
    uint32 LeftArrowActiveSlot;
    uint32 RightArrowActiveSlot;
    uint32 LeftBoltActiveSlot;
    uint32 RightBoltActiveSlot;
} ArmStyleAndActiveWeaponSlots;

// Inventory. Counts = occupied entries. EquipIndexCounter = highest entry
// index in use (key items 0..len(key)-1, common items len(key)+position).
typedef struct {
    uint32 GaitemHandle <format=hex>;   // 0 = empty
    uint32 Quantity;
    uint32 AcquisitionIndex;
} EquipInventoryDataEntry;

typedef struct (int commonItemsCapacity, int keyItemsCapacity) {
    uint32 CommonItemsCount;
    EquipInventoryDataEntry CommonItems[commonItemsCapacity] <read=Str("[%X, %d]", this.GaitemHandle, this.Quantity)>;
    uint32 KeyItemsCount;
    EquipInventoryDataEntry KeyItems[keyItemsCapacity] <read=Str("[%X, %d]", this.GaitemHandle, this.Quantity)>;
    uint32 EquipIndexCounter;
    uint32 AcquisitionIndexCounter;
} Inventory;

// Equipped spells (0x74)
typedef struct {
    int32 SpellID;
    int32 unk0x4;   // -1 on filled slots, 0 on empty
} SpellSlot;
typedef struct {
    SpellSlot SpellSlots[0xE] <read=Str("%d", this.SpellID)>;
    int32 ActiveIndex;
} EquipMagicData;

// Equipped items (0x8C)
typedef struct {
    uint32 GaitemHandle <format=hex>;
    int32 EquipmentIndex;
} EquippedItem;
typedef struct {
    EquippedItem QuickItems[0xA] <read=Str("%X", this.GaitemHandle)>;
    uint32 ActiveSlot;
    EquippedItem PouchItems[0x6] <read=Str("%X", this.GaitemHandle)>;
    uint32 GreatRune <format=hex>;  // 0xB0000000 | goods id (191-196), 0 if none
    int32 GreatRuneEquipIndex;      // key item index, -1 if none
} EquipItemData;

// Gesture wheel (0x18): stored value = gesture id - 1 (2k for gesture index k)
typedef struct {
    uint32 EquippedGesture[0x6];
} GestureEquipData;

// Chest auto-refill settings
typedef struct {
    uint32 ItemID <format=hex>;     // ammo weapon id or 0x40000000 | goods id
    uint32 AutoRefill;              // 1 = auto-refill ON
} AutoRefillEntry;
typedef struct {
    uint32 Count;
    if (Count > 0)
        AutoRefillEntry Entries[Count] <read=Str("%X: %d", this.ItemID, this.AutoRefill)>;
} AutoRefillData;

// Equipped item ids (0x9C)
typedef struct {
    int32 LeftHandArmament1 <format=hex>;
    int32 RightHandArmament1 <format=hex>;
    int32 LeftHandArmament2 <format=hex>;
    int32 RightHandArmament2 <format=hex>;
    int32 LeftHandArmament3 <format=hex>;
    int32 RightHandArmament3 <format=hex>;
    int32 Arrows1 <format=hex>;
    int32 Bolts1 <format=hex>;
    int32 Arrows2 <format=hex>;
    int32 Bolts2 <format=hex>;
    int32 Arrows3 <format=hex, hidden = true>;
    int32 Bolts3 <format=hex, hidden = true>;
    int32 Head <format=hex>;
    int32 Chest <format=hex>;
    int32 Arms <format=hex>;
    int32 Legs <format=hex>;
    int32 Hair <format=hex, hidden = true>;
    int32 Talisman1 <format=hex>;
    int32 Talisman2 <format=hex>;
    int32 Talisman3 <format=hex>;
    int32 Talisman4 <format=hex>;
    int32 Talisman5 <format=hex, hidden = true>;
    int32 QuickItems[10] <format=hex>;
    int32 PouchItems[6] <format=hex>;
    int32 unk0x98 <format=hex, hidden = true>;  // always -1
} EquippedArmamentsAndItems;

// Wondrous Physick tears (0xC)
typedef struct {
    int32 Slot1;
    int32 Slot2;
    int32 unk0x8;   // always -1
} PhysicEquipData;

//------------------------------------------------
// Appearance
//------------------------------------------------

// FACE block. Field names are offsets from the FACE magic, matching the preset
// field names. Slot and ProfileSummary copies are 0x120 bytes, presets 0x118.
typedef struct (int blockLen) {
    char Magic[4];
    uint32 Alignment;
    uint32 Size <format = hex>;

    ubyte FaceModel;        ubyte Padding0[3] <hidden = true>;
    ubyte HairModel;        ubyte Padding1[3] <hidden = true>;
    ubyte EyeModel;         ubyte Padding2[3] <hidden = true>;
    ubyte EyeBrowModel;     ubyte Padding3[3] <hidden = true>;
    ubyte BeardModel;       ubyte Padding4[3] <hidden = true>;
    ubyte AccessoryModel;   ubyte Padding5[3] <hidden = true>;
    ubyte DecalModel;       ubyte Padding6[3] <hidden = true>;
    ubyte EyelashModel;     ubyte Padding7[3] <hidden = true>;

    // Facial structure (64 bytes)
    ubyte ApparentAge;
    ubyte FacialAesthetic;
    ubyte FormEmphasis;
    ubyte unk0x2f;
    ubyte BrowRidgeHeight;
    ubyte InnerBrowRidge;
    ubyte OuterBrowRidge;
    ubyte CheekboneHeight;
    ubyte CheekboneDepth;
    ubyte CheekboneWidth;
    ubyte CheekboneProtrusion;
    ubyte Cheeks;
    ubyte ChinTipPosition;
    ubyte ChinLength;
    ubyte ChinProtrusion;
    ubyte ChinDepth;
    ubyte ChinSize;
    ubyte ChinHeight;
    ubyte ChinWidth;
    ubyte EyePosition;
    ubyte EyeSize;
    ubyte EyeSlant;
    ubyte EyeSpacing;
    ubyte NoseSize;
    ubyte NoseForeheadRatio;
    ubyte unk0x45;
    ubyte FaceProtrusion;
    ubyte VerticalFaceRatio;
    ubyte FacialFeatureSlant;
    ubyte HorizontalFaceRatio;
    ubyte unk0x4a;
    ubyte ForeheadDepth;
    ubyte ForeheadProtrusion;
    ubyte unk0x4d;
    ubyte JawProtrusion;
    ubyte JawWidth;
    ubyte LowerJaw;
    ubyte JawContour;
    ubyte LipShape;
    ubyte LipSize;
    ubyte LipFullness;
    ubyte MouthExpression;
    ubyte LipProtrusion;
    ubyte LipThickness;
    ubyte MouthProtrusion;
    ubyte MouthSlant;
    ubyte Occlusion;
    ubyte MouthPosition;
    ubyte MouthWidth;
    ubyte MouthChinDistance;
    ubyte NoseRidgeDepth;
    ubyte NoseRidgeLength;
    ubyte NosePosition;
    ubyte NoseTipHeight;
    ubyte NostrilSlant;
    ubyte NostrilSize;
    ubyte NostrilWidth;
    ubyte NoseProtrusion;
    ubyte NoseBridgeHeight;
    ubyte BridgeProtrusion1;
    ubyte BridgeProtrusion2;
    ubyte NoseBridgeWidth;
    ubyte NoseHeight;
    ubyte NoseSlant;

    // FaceGen parameters not exposed in character creation (128 or 0)
    ubyte unk0x6c[64];

    // Body scale
    ubyte HeadSize;
    ubyte ChestSize;
    ubyte AbdomenSize;
    ubyte RightArmSize;
    ubyte RightLegSize;
    ubyte LeftArmSize;
    ubyte LeftLegSize;

    // Colors (91 bytes)
    ubyte SkinColorR;
    ubyte SkinColorG;
    ubyte SkinColorB;
    ubyte SkinLuster;
    ubyte Pores;
    ubyte Stubble;
    ubyte DarkCircles;
    ubyte DarkCircleColorR;
    ubyte DarkCircleColorG;
    ubyte DarkCircleColorB;
    ubyte CheeksColorIntensity;
    ubyte CheekColorR;
    ubyte CheekColorG;
    ubyte CheekColorB;
    ubyte EyeLiner;
    ubyte EyeLinerColorR;
    ubyte EyeLinerColorG;
    ubyte EyeLinerColorB;
    ubyte EyeShadowLower;
    ubyte EyeShadowLowerColorR;
    ubyte EyeShadowLowerColorG;
    ubyte EyeShadowLowerColorB;
    ubyte EyeShadowUpper;
    ubyte EyeShadowUpperColorR;
    ubyte EyeShadowUpperColorG;
    ubyte EyeShadowUpperColorB;
    ubyte LipStick;
    ubyte LipStickColorR;
    ubyte LipStickColorG;
    ubyte LipStickColorB;
    ubyte TattooMarkPositionHorizontal;
    ubyte TattooMarkPositionVertical;
    ubyte TattooMarkAngle;
    ubyte TattooMarkExpansion;
    ubyte TattooMarkColorR;
    ubyte TattooMarkColorG;
    ubyte TattooMarkColorB;
    ubyte unk0xd8;
    ubyte TattooMarkFlip;
    ubyte BodyHair;
    ubyte BodyHairColorR;
    ubyte BodyHairColorG;
    ubyte BodyHairColorB;
    ubyte RightIrisColorR;
    ubyte RightIrisColorG;
    ubyte RightIrisColorB;
    ubyte RightIrisSize;
    ubyte RightEyeClouding;
    ubyte RightEyeCloudingColorR;
    ubyte RightEyeCloudingColorG;
    ubyte RightEyeCloudingColorB;
    ubyte RightEyeWhiteColorR;
    ubyte RightEyeWhiteColorG;
    ubyte RightEyeWhiteColorB;
    ubyte RightEyePosition;
    ubyte LeftIrisColorR;
    ubyte LeftIrisColorG;
    ubyte LeftIrisColorB;
    ubyte LeftIrisSize;
    ubyte LeftEyeClouding;
    ubyte LeftEyeCloudingColorR;
    ubyte LeftEyeCloudingColorG;
    ubyte LeftEyeCloudingColorB;
    ubyte LeftEyeWhiteColorR;
    ubyte LeftEyeWhiteColorG;
    ubyte LeftEyeWhiteColorB;
    ubyte LeftEyePosition;
    ubyte HairColorR;
    ubyte HairColorG;
    ubyte HairColorB;
    ubyte HairLuster;
    ubyte HairRootDarkness;
    ubyte HairWhiteHairs;
    ubyte BeardColorR;
    ubyte BeardColorG;
    ubyte BeardColorB;
    ubyte BeardLuster;
    ubyte BeardRootDarkness;
    ubyte BeardWhiteHairs;
    ubyte BrowColorR;
    ubyte BrowColorG;
    ubyte BrowColorB;
    ubyte BrowLuster;
    ubyte BrowRootDarkness;
    ubyte BrowWhiteHairs;
    ubyte EyelashColorR;
    ubyte EyelashColorG;
    ubyte EyelashColorB;
    ubyte AccessoryColorR;
    ubyte AccessoryColorG;
    ubyte AccessoryColorB;

    // 255 = Frenzied Flame eyes; only set in the ProfileSummary copy
    ubyte EyeEffect;
    ubyte Padding8[blockLen - 0x10F] <hidden = true>;
} FaceBlock;

// Face param override: FaceParam id set by EMEVD Set Character Face Param
// Override (81000 Frenzied Flame, 81001 Varre's quest, 81002, slot 1 80000)
typedef int32 FaceParamOverride <read=Str("%d%s", this, this == -1 ? " (none)" : "")>;

// Slot FaceData (0x12F)
typedef struct {
    int32 Marker;   // -1
    FaceBlock Face(0x120);
    ubyte unk0x124; // 1
    ubyte unk0x125;
    ubyte unk0x126;
    FaceParamOverride OverrideSlot0;
    FaceParamOverride OverrideSlot1;
} FaceData;

// Unlocked gestures (0x100): 2k or 2k + 1 for gesture index k, -2 = empty
typedef struct {
    int32 GestureID[0x40];
} GestureGameData;

typedef struct {
    uint32 RegionsCount;
    if (RegionsCount > 0) {
        uint32 RegionsIds[RegionsCount];
    }
} Regions;

// Torrent (0x28). HP 0 with state Active loads forever; Dead fixes it.
typedef enum <uint32> { InActive = 1, Dead = 3, Active = 13 } HorseState;
typedef struct {
    FloatVector3 Coordinates;
    M MapId;
    FloatVector4 Angle;
    int32 HP;
    HorseState State;
} RideGameData;

// Bloodstain (0x44), same layout as GameDataMan+0x48
typedef struct {
    FloatVector3 Coordinates;
    FloatVector4 Angle;
    uint32 unk0x1c[5] <hidden = true>;
    int32 Present;          // 0 while a bloodstain exists, -1 otherwise
    int32 Runes;            // -1 = none
    M MapID;
    uint32 unk0x3c <hidden = true>;
    uint32 unk0x40 <format = hex>; // 0x8FF0 << 16 | n, n per death location
} BloodStainData;

//------------------------------------------------
// Menu data
//------------------------------------------------

// Beacon / map marker record (16 bytes)
typedef struct {
    int32 ID;           // -1 = empty; beacons use an increasing sequence number
    float X;
    float Y;
    ubyte Map;          // 0 Lands Between, 10 Realm of Shadow
    ubyte Icon;         // 1 for beacons and empty records
    uint16 unk0xe <format = hex>;  // 0xFFFF on a newly placed beacon
} MapMarker <read=Str("%d (%.1f, %.1f) map %d icon %d", ID, X, Y, Map, Icon)>;

// World map menu data (CSMenuSimpleSaveDataChunk<1, MENU_WORLD_MAP_SAVEDATA, 2>)
typedef struct {
    uint16 unk0x0 <hidden = true>;
    uint16 unk0x2 <hidden = true>;
    uint32 Size <format = hex>;
    local int64 dataStart = FTell();
    // Normally 0x1000; an out of range size is read as 0x1000
    local int64 dataEnd = dataStart + (Size > 0x10000 ? 0x1000 : Size);

    uint16 ChunkType;       // 1
    uint16 ChunkVersion;    // 2 (older characters 0)
    uint32 ChunkSize <format = hex>;
    if (ChunkVersion == 2 && dataEnd - dataStart >= 0xFD8) {
        float unk0x8[4];
        uint32 unk0x18;
        ubyte unk0x1c[0x108 - 0x1C] <hidden = true>;
        MapMarker Beacons[10];
        MapMarker Markers[100];
        int64 unk0x7e8;             // -2
        ubyte unk0x7f0[0xFD0 - 0x7F0];
        float MapCursorX;
        float MapCursorY;
        ubyte unk0xfd8[8];
        uint32 unk0xfe0;            // 0 or 1, end of the nested chunk
    }
    if (FTell() < dataEnd)
        ubyte Remainder[dataEnd - FTell()];
} MenuProfileSaveLoad;

// Legendary trophy progress: bit n = n-th legendary item of the type by id
typedef struct {
    int32 unk0x0;
    ubyte LegendaryWeapons[0x10];
    ubyte LegendaryGoods[0x10];       // bits 0-6 sorceries/incantations, 7-12 spirit ashes
    ubyte LegendaryTalismans[0x10];
} TrophyEquipData;

// Every item type ever acquired: first Count entries live and sorted by id
typedef struct {
    uint32 ItemID <format = hex>;   // category tagged id
    ubyte unk0x4;                   // 1
    ubyte Padding[3] <hidden = true>;
} GaitemGameDataEntry <read=Str("%X", ItemID)>;
typedef struct {
    int64 Count;
    GaitemGameDataEntry Items[14000];
} GaitemGameData;

// Tutorial pop-ups already shown (TutorialParam row ids)
typedef struct {
    uint16 unk0x0;      // 174
    uint16 unk0x2;      // 1
    uint32 Size <format = hex>;
    local int64 dataEnd = FTell() + Size;
    uint32 Count;
    if (Count > 0 && Count <= (Size - 4) / 4)
        uint32 TutorialIds[Count];
    if (FTell() < dataEnd)
        ubyte Unused[dataEnd - FTell()] <hidden = true>;
} CSTutorialData;

//------------------------------------------------
// Event flags
//------------------------------------------------

// Flag N: block = N / 1000, index = N % 1000,
// byte = bst[block] * 125 + index / 8 (eventflag_bst.txt), F<index % 8>.
typedef struct {
    ubyte F0 : 1;
    ubyte F1 : 1;
    ubyte F2 : 1;
    ubyte F3 : 1;
    ubyte F4 : 1;
    ubyte F5 : 1;
    ubyte F6 : 1;
    ubyte F7 : 1;
} EventFlag <read=Str("%d%d%d%d%d%d%d%d", F0, F1, F2, F3, F4, F5, F6, F7)>;

//------------------------------------------------
// World state blocks
//------------------------------------------------

typedef struct {
    M Id;
} MapRef <read=MapIdAt(startof(Id))>;

// FieldArea: dungeon -> adjacent open world tiles
typedef struct {
    M MapId;
    uint32 Count;
    if (Count > 0)
        MapRef Adjacent[Count];
} FieldAreaEntry <read=Str("%s (%d)", MapIdAt(startof(MapId)), Count)>;

typedef struct {
    int32 Size;
    // Out of range: only the size field is stored (torn slot)
    if (Size > 0 && Size < 0x10000) {
        local int64 end = FTell() + Size;
        uint32 Count;
        if (Count > 0 && Count < 0x1000)
            FieldAreaEntry Entries[Count] <optimize = false>;
        if (FTell() < end)
            ubyte Unparsed[end - FTell()];
        FSeek(end);
    }
} CSFieldArea;

// WorldArea entry: bit 30 set, 16-29 model, 2-15 MSB part instance,
// 0-1 state (3 = killed or disabled)
typedef uint32 ChrEntry <read=Str("c%04d_%04d state %d", (this >> 16) & 0x3FFF, (this >> 2) & 0x3FFF, this & 3)>;

typedef struct {
    char Magic[4];          // CSBC
    M MapId;
    uint32 Size <format = hex>;
    if (ReadUInt(startof(MapId)) == 0xFFFFFFFF) {
        uint32 unk0xc;
    } else {
        uint32 Head <format = hex>;
        local uint32 n = Head & 0x3FFF;
        local uint32 EnemyPartCount = Head >> 14;
        if (n > 0)
            ChrEntry Entries[n];
        if (Size > 16 + 4 * n)
            ubyte Padding[Size - 16 - 4 * n] <hidden = true>;
    }
} ChrMapRecord <read=Str("%s (%d)", MapIdAt(startof(MapId)), exists(Entries) ? sizeof(Entries) / 4 : 0)>;

typedef struct {
    int32 Size;
    // Out of range: only the size field is stored (torn slot)
    if (Size > 0 && Size < 0x10000) {
        local int64 end = FTell() + Size;
        char Magic[4];      // "CHR "
        uint32 Version <format = hex>;   // 0x21042700
        uint64 unk0x8;
        local uint32 recMap;
        local uint32 recSize;
        while (FTell() + 16 <= end) {
            if (ReadUInt(FTell()) != 0x43425343)    // "CSBC"
                break;
            recMap = ReadUInt(FTell() + 4);
            recSize = ReadUInt(FTell() + 8);
            if (recMap != 0xFFFFFFFF && (recSize < 16 || FTell() + recSize > end))
                break;
            ChrMapRecord Records;
            if (recMap == 0xFFFFFFFF)
                break;
        }
        if (FTell() < end)
            ubyte Unparsed[end - FTell()];
        FSeek(end);
    }
} CSWorldArea;

// WorldGeomMan entry: key = instance << 15 | state, model = 10000000 + AEG id
typedef struct {
    uint32 Key <format = hex>;
    uint32 Model;
} GeomEntry <read=Str("AEG%03d_%03d_%04d state %d", (Model - 10000000) / 1000, (Model - 10000000) % 1000, Key >> 15, Key & 0x7FFF)>;

typedef struct {
    M MapId;
    uint32 Size <format = hex>;
    uint32 Count;
    uint32 unk0xc;          // per map constant
    if (ReadUInt(startof(MapId)) != 0xFFFFFFFF && Count > 0)
        GeomEntry Entries[Count];
} GeomMapRecord <read=Str("%s (%d)", MapIdAt(startof(MapId)), Count)>;

// MOEG: broken (1), picked since rest (3), picked permanently (2)
// FOEG: permanently picked one-time nodes (1)
typedef struct {
    int32 Size;
    // Out of range: only the size field is stored (torn slot)
    if (Size > 0 && Size < 0x100000) {
        local int64 end = FTell() + Size;
        char Magic[4];
        uint32 Version <format = hex>;   // 0x21042600
        local uint32 recMap;
        local uint32 recSize;
        local uint32 recCount;
        while (FTell() + 16 <= end) {
            recMap = ReadUInt(FTell());
            recSize = ReadUInt(FTell() + 4);
            recCount = ReadUInt(FTell() + 8);
            if (recMap != 0xFFFFFFFF && (recSize != 16 + 8 * recCount || FTell() + recSize > end))
                break;
            GeomMapRecord Records;
            if (recMap == 0xFFFFFFFF)
                break;
        }
        if (FTell() < end)
            ubyte Unparsed[end - FTell()];
        FSeek(end);
    }
} CSWorldGeomMan;

// Ground decal (40 bytes)
typedef struct {
    uint32 DecalParamId;
    int16 Points[9];        // three (x, y, z) in 1/8 units, local to the player's map
    uint16 unk0x16;
    uint32 unk0x18[4];
} Decal <read=Str("%d (%.1f, %.1f, %.1f)", DecalParamId, Points[0] / 8.0, Points[1] / 8.0, Points[2] / 8.0)>;

typedef struct {
    int32 Size;
    // Out of range: only the size field is stored (torn slot)
    if (Size > 0 && Size < 0x100000) {
        local int64 end = FTell() + Size;
        uint32 Count;
        if (Count > 0 && 4 + Count * 40 <= Size)
            Decal Decals[Count];
        if (FTell() < end)
            ubyte Unparsed[end - FTell()];
        FSeek(end);
    }
} CSRendMan;

// PlayerCoords (0x3D). On m60/m61 coordinates are local to the _00 tile:
// global = tile * 256 + 128 + local
typedef struct {
    FloatVector3 Coordinates;
    M MapID;
    FloatVector4 Angle;
    ubyte game_man_0xBF0;
    FloatVector3 UnkCoordinates;
    FloatVector4 UnkAngle;
} CSPlayerCoords;

//------------------------------------------------
// NetMan (0x20004): u32 2, then a chunk chain in 0x20000 bytes
//------------------------------------------------

// Own message (600 bytes)
typedef struct {
    uint32 AuthorTag <format = hex>;
    ubyte unk0x4[8];
    M MapId;
    ubyte unk0x10[20];
    FloatVector3 Position;
    float Angle;
    uint16 Template;        // BloodMsg FMG id
    ubyte Gesture;          // gesture index, 0xFF = none
    ubyte unk0x37;
    uint32 Word;            // BloodMsg FMG id
    uint32 unk0x3c;
    uint16 Ratings[2];
    uint16 unk0x44;
    ubyte Protected;
    ubyte unk0x47;
    int32 Weapons[6];       // L1, R1, L2, R2, L3, R3
    int32 Ammo[6];
    int32 Armor[4];
    int32 unk0x88[5];
    ArmStyleAndActiveWeaponSlots ActiveWeaponSlots;
    FaceBlock Face(0x120);
    wchar_t AuthorName[0x10];
    ubyte unk0x1f8[600 - 0x1F8];
} OwnMessage <read=Str("%s %d/%d", MapIdAt(startof(MapId)), Template, Word)>;

// Cached message of another player (606 bytes; one 602-byte variant has
// a 4 byte shorter prefix)
typedef struct (uint32 size) {
    local int64 s0 = FTell();
    ubyte Equipment[size - 0x1EA];
    FaceBlock Face(0x120);
    wchar_t AuthorName[0x10];
    ubyte unk0x1b4[0x10];
    M MapId;
    uint32 unk0x1c8;
    FloatVector3 Position;
    float Angle;
    uint16 Template;
    ubyte Gesture;
    ubyte unk0x1df;
    uint32 Word;
    ubyte unk0x1e4[size - (FTell() - s0)];
} CachedMessage <read=Str("%s %d/%d", MapIdAt(startof(MapId)), Template, Word)>;

typedef struct {
    uint32 ID;
    uint32 unk0x4;          // 0 or 10
    ubyte Flags[4];
} Chunk8Entry;

typedef struct (uint16 chunkType) {
    uint32 Kind;
    uint32 Size;
    if (chunkType == 6 && Kind == 0 && Size == 600)
        OwnMessage Message;
    else if (chunkType == 6 && Kind == 1 && (Size == 606 || Size == 602))
        CachedMessage Message(Size);
    else if (chunkType == 8 && Size == 12)
        Chunk8Entry Entry;
    else if (Size > 0)
        ubyte Data[Size];
    if (Size % 4)
        ubyte Padding[4 - Size % 4] <hidden = true>;
} NetSubEntry;

typedef struct {
    uint16 Type;
    uint16 Version;
    uint32 Size <format = hex>;
    if (Type != 0xFFFF && Size > 0) {
        local int64 end = FTell() + Size;
        if (Type == 8)
            uint32 Header[3];
        while (FTell() + 8 <= end) {
            if (ReadUInt(FTell()) == 0xFFFF) {
                uint32 EndKind <hidden = true>;
                uint32 EndSize <hidden = true>;
                break;
            }
            if (ReadUInt(FTell() + 4) > end - FTell() - 8)
                break;
            NetSubEntry Entries(Type);
        }
        if (FTell() < end)
            ubyte Unparsed[end - FTell()];
        FSeek(end);
    }
} NetChunk <read=Str("type %d v%d size %X", Type, Version, Size)>;

typedef struct {
    local int64 start = FTell();
    local int64 end = start + 0x20004;
    uint32 unk0x0;      // 2
    local uint16 ct;
    local uint32 cs;
    while (FTell() + 8 <= end) {
        ct = ReadUShort(FTell());
        cs = ReadUInt(FTell() + 4);
        if (ct != 0xFFFF && cs > end - FTell() - 8) {
            Printf("NetMan at %Xh: chunk type %d size %Xh runs past the region (corrupt)\n", FTell(), ct, cs);
            break;
        }
        NetChunk Chunks;
        if (ct == 0xFFFF)
            break;
    }
    if (FTell() < end)
        ubyte Unused[end - FTell()] <hidden = true>;
} CSNetMan;

//------------------------------------------------
// Slot tail
//------------------------------------------------

typedef enum <uint16> {
    None2 = 0xFFFF,
    Default = 0,
    Cloudless = 1,
    FlatClouds = 10,
    PuffyClouds = 11,
    Rain = 20,
    RainyCloud = 21,
    WindyRain = 30,
    WindyFog = 31,
    Snow = 40,
    HeavySnow = 41,
    Fog = 50,
    HeavyFog = 51,
    RainyHeavyFog = 52,
    WindyPuffyClouds = 60,
    SnowyHeavyFog = 81,
    ScatteredRain = 82,
    Unknown83 = 83,
    Unknown84 = 84,
    Unknown85 = 85,
    Unknown86 = 86,
    Unknown87 = 87,
    Unknown88 = 88
} WeatherTypeEnum;

// area_id 0 while the character is in a real location indicates corruption
typedef struct {
    uint16 AreaId;
    WeatherTypeEnum WeatherType;
    uint32 Timer;
    uint32 padding <hidden = true>;
} CSWorldAreaWeather;

// In-game time of day; hour > 23 or minute/second > 59 is corrupt
typedef struct {
    uint32 Hour;
    uint32 Minute;
    uint32 Seconds;
} CSWorldAreaTime <read=Str("%02d:%02d:%02d", Hour, Minute, Seconds)>;

typedef struct {
    int BaseVersionCopy;
    int BaseVersion;
    Boolean BaseVersionIsLatest;
    int unk0xc <hidden = true>;
} BaseVersion;

// PS5 activity cards: 0 not started, 1 in progress, 2 completed
typedef struct {
    ubyte MainStory;
    ubyte Godrick;
    ubyte Radahn;
    ubyte Morgott;
    ubyte FireGiant;
    ubyte Maliketh;
    ubyte HoarahLoux;
    ubyte Colosseum;    // follows event flag 6080
    ubyte unk0x8[0x18];
} CSPS5Activity;

typedef struct {
    ubyte TheRingPreorderGesture;
    ubyte EnteredShadowOfTheErdtree;    // set without the DLC: slot fails to load
    ubyte RingOfMiquellaPreorderGesture;
    ubyte TarnishedEditionPack;         // set without the content: slot fails to load
    ubyte unk0x4[0x2E];                 // non-zero = corruption
} CSDlc;

// 11 checksums + 0x54 bytes of uninitialized memory. Stale entries are
// highlighted (the game rewrites them on save; other editors leave them).
typedef struct (
    PlayerGameData &player,
    ChrAsmEquipment &equipment,
    EquipMagicData &spells
    ) {
    local uint words[14];
    local uint ok;

    ok = ValueHash(player.Level);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint Level <format = hex>;

    words[0] = player.Vigor;      words[1] = player.Mind;
    words[2] = player.Endurance;  words[3] = player.Strength;
    words[4] = player.Dexterity;  words[5] = player.Intelligence;
    words[6] = player.Faith;      words[7] = player.Arcane;
    words[8] = player.unk0x54;
    ok = WordsHash(words, 9);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint Stats <format = hex>;

    ok = ValueHash(player.ArcheType);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint ArcheType <format = hex>;

    local ubyte one[1];
    one[0] = player.unk0xb8;
    ok = BytesHash(one, 1);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint PlayerGameData0xB8 <format = hex>;

    SetBackColor(cNone);
    uint unk0x10 <format = hex>;

    ok = ValueHash(player.Runes);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint Runes <format = hex>;

    ok = ValueHash(player.RunesMemory);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint RunesMemory <format = hex>;

    words[0] = equipment.LeftHandArmament1;  words[1] = equipment.LeftHandArmament2;
    words[2] = equipment.LeftHandArmament3;  words[3] = equipment.RightHandArmament1;
    words[4] = equipment.RightHandArmament2; words[5] = equipment.RightHandArmament3;
    words[6] = equipment.Arrows1;            words[7] = equipment.Arrows2;
    words[8] = equipment.Bolts1;             words[9] = equipment.Bolts2;
    ok = WordsHash(words, 10);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint EquippedWeapons <format = hex>;

    words[0] = equipment.Head;       words[1] = equipment.Chest;
    words[2] = equipment.Arms;       words[3] = equipment.Legs;
    words[4] = equipment.Talisman1;  words[5] = equipment.Talisman2;
    words[6] = equipment.Talisman3;  words[7] = equipment.Talisman4;
    words[8] = equipment.Talisman5;
    ok = WordsHash(words, 9);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint EquippedArmorsAndTalismans <format = hex>;

    // Inputs unknown (quick items)
    SetBackColor(cNone);
    uint EquippedItems <format = hex>;

    local int i = 0;
    while (i < 14) {
        words[i] = spells.SpellSlots[i].SpellID;
        i = i + 1;
    }
    ok = WordsHash(words, 14);
    SetBackColor(ok == ReadUInt(FTell()) ? cNone : cLtRed);
    uint EquippedSpells <format = hex>;

    SetBackColor(cNone);
    ubyte Uninitialized[0x54] <hidden = true>;
} CSPlayerGameDataHash;

//------------------------------------------------
// Character slot (0x280000 data bytes, plus a 16-byte MD5 on PC)
//------------------------------------------------

typedef enum <int32> {
    None = -1, Host = 0, Phantom = 1, Invader = 2, Ghost = 3, DeadGhost = 10,
    NakedGhost = 11, Unknown13 = 13, NakedGhost2 = 14, Invader2 = 15,
    Invader3 = 16, Blue = 17, Invader4 = 18
} CT;

typedef struct (int hasChecksum) {
    local int64 slotStart = FTell();
    if (hasChecksum)
        ubyte Checksum[0x10] <format = hex>;
    local int64 dataStart = FTell();
    local int64 dataEnd = dataStart + 0x280000;

    uint32 Version;
    if (Version == 0) {
        // Empty slot
        ubyte Data[0x280000 - 4] <hidden = true>;
    } else {
        M MapID;
        uint64 PlayTimeMs;
        ubyte unk0x10[0x10] <hidden = true>;    // new value on every slot write

        // 5118 entries up to version 81, 5120 after
        local int count = 0x1400;
        if (Version <= 81)
            count = 0x13FE;
        Item GaitemHandleMap[count] <optimize=false, read=Str("%X -> %X", this.GaitemHandle, this.ItemID)>;

        PlayerGameData Player;
        SPEffects SpEffects[0xD] <read=Str("%d", this.SPEffectID)>;

        ChrAsmEquipment EquippedItemsEquipIndex;
        ArmStyleAndActiveWeaponSlots ActiveEquippedWeaponSlots;
        ChrAsmEquipment EquippedItemsItemIds;
        DisplayFormatHex();
        ChrAsmEquipment EquippedItemsGaitemHandles;
        DisplayFormatDecimal();
        Inventory InventoryHeld(0xA80, 0x180);
        EquipMagicData EquippedSpells;
        EquipItemData EquippedItems;
        GestureEquipData EquippedGestures;
        AutoRefillData AutoRefill;
        EquippedArmamentsAndItems EquippedArmamentsandItems;
        PhysicEquipData EquippedPhysics;

        FaceData Facedata;

        Inventory InventoryStorageBox(0x780, 0x80);

        GestureGameData Gestures;
        Regions UnlockedRegions;
        RideGameData Horse;

        ubyte ControlByte <hidden = true>;

        BloodStainData BloodStain;

        uint32 ClearCount;              // NG+ cycle, 0 = first playthrough
        uint32 unk_gameDataMan_0x88 <hidden = true>;

        MenuProfileSaveLoad WorldMapMenu;
        TrophyEquipData Trophies;
        GaitemGameData ItemHistory;
        CSTutorialData TutorialData;

        ubyte GameMan_0x8c <hidden = true>;
        ubyte GameMan_0x8d <hidden = true>;
        ubyte GameMan_0x8e <hidden = true>;

        uint32 TotalDeathsCount;
        CT CharacterType;               // -1 by default
        ubyte InOnlineSessionFlag;
        uint32 OnlineCharacterType;     // 8 by default
        // BonfireWarpParam bonfireEntityId + 1000, 0 if none
        uint32 LastRestedGrace;
        ubyte NotAloneFlag;
        uint32 InGameTimer;
        uint32 unk_gameDataMan_0x124 <hidden = true>;   // random 0-99, rerolled on area load

        EventFlag EventFlags[0x1BF99F];
        ubyte EventFlagTerminator <hidden = true>;

        CSFieldArea FieldArea;
        CSWorldArea WorldArea;
        CSWorldGeomMan WorldGeom;
        CSWorldGeomMan WorldGeom2;
        CSRendMan RendMan;

        CSPlayerCoords PlayerCoordinates;

        ubyte GameMan_0x5BE <hidden = true>;
        ubyte GameMan_0x5BF;            // 1 after warping to a grace, 0 after resting
        uint32 SpawnPointEntityId;
        uint32 GameMan_0xB64;           // 0, or a spawn point entity id

        if (Version >= 65)
            uint32 TempSpawnPointEntityId;
        if (Version >= 66)
            ubyte GameMan_0xCB3;

        CSNetMan NetMan;

        CSWorldAreaWeather WorldAreaWeather;
        CSWorldAreaTime WorldAreaTime;
        BaseVersion BaseCharacterVersion;

        // Steam64 on PC (must match USER_DATA_10), 0 on PlayStation
        uint64 SteamId;

        CSPS5Activity PS5Activity;
        CSDlc DLC;

        CSPlayerGameDataHash PlayerGameDataHash(Player, EquippedItemsItemIds, EquippedSpells);

        // Leftover serializer buffer, never read by the game
        if (FTell() < dataEnd)
            ubyte Rest[dataEnd - FTell()] <hidden = true>;
        else if (FTell() > dataEnd)
            Printf("Slot at %Xh: parse ran %Xh bytes past the slot end\n", slotStart, FTell() - dataEnd);
    }
    FSeek(dataEnd);
} Slot <read=SlotRead>;

string SlotRead(Slot &s) {
    if (s.Version == 0)
        return "empty";
    return Str("%03d | %s", s.Player.Level, s.Player.CharacterName);
}

//------------------------------------------------
// USER_DATA_10
//------------------------------------------------

typedef struct {
    ubyte CameraSpeed;
    ubyte ControllerVibration;
    ubyte Brightness;
    ubyte SoundType;
    ubyte MusicVolume;
    ubyte SoundEffectsVolume;
    ubyte VoiceVolume;
    ubyte DisplayBlood;
    ubyte Subtitles;
    ubyte HUD;
    ubyte CameraXAxis;
    ubyte CameraYAxis;
    ubyte ToggleAutoLockOn;
    ubyte CameraAutoWallRecovery;
    ubyte Unk0xE;           // not in the PC menu
    ubyte Unk0xF;           // not in the PC menu (default 1)
    ubyte ResetCameraYAxis;
    ubyte CinematicEffects;
    ubyte Unk0x12;          // not in the PC menu
    ubyte CrossRegionPlay;
    ubyte VoiceChat;
    ubyte DisplayPlayerNames;
    ubyte ManualAttackAim;
    ubyte AutoTarget;
    ubyte LaunchSetting;
    ubyte SendSummonSign;
    ubyte Unk0x1A;          // not in the PC menu (default 1)
    ubyte HDR;
    ubyte HDRAdjustBrightness;
    ubyte HDRMaximumBrightness;
    ubyte HDRAdjustSaturation;
    ubyte Unk0x1F;          // not in the PC menu (default 1)
    ubyte MasterVolume;
    ubyte RayTracing;       // 0 off, 1 any quality
    ubyte MarkNewItems;
    ubyte ShowRecentTabs;
    ubyte Unk0x24[0xA] <hidden = true>;
    ubyte ShowTutorials;
    ubyte CameraAutoRotation;
    ubyte JustZero[0x110] <hidden = true>;
} CSSettings;

// Appearance preset (0x130)
typedef struct {
    ubyte unk0x0[8] <hidden = true>;
    ubyte Used;             // 1 on a used preset
    ubyte BodyType;
    ubyte Uninitialized[0xA] <hidden = true>;
    int32 FaceDataMarker <hidden = true>;
    if (ReadUInt(FTell()) == 0x45434146)    // "FACE"
        FaceBlock Face(0x118);
    else
        ubyte Empty[0x118] <hidden = true>;
} FacePreset <read=Str("%s", exists(Face) ? "used" : "empty")>;

typedef struct {
    uint16 Unk0x0 <hidden = true>;
    uint16 Unk0x2 <hidden = true>;
    uint32 Size <format = hex>;    // 0x1800; the block is fixed size
    local int64 end = startof(Unk0x0) + 0x1808;
    FacePreset Presets[15] <optimize = false>;
    // 16-byte records, meaning unknown
    if (FTell() < end)
        ubyte Records[end - FTell()];
} CSMenuSystemSaveLoad;

// Profile equipment (58 uint32)
typedef struct {
    int32 unk0x0;           // -1
    uint32 unk0x4;          // 0
    ArmStyleAndActiveWeaponSlots ActiveEquippedWeaponsSlots;
    // weapons 0x80000000 | (id & 0x7FFFFF), armor 0x9..., talismans 0xA...
    DisplayFormatHex();
    ChrAsmEquipment TaggedIds;
    DisplayFormatDecimal();
    ChrAsmEquipment ItemIds;
    int32 Unk0xD4[2];       // -1 -1 or one id twice (Convergence)
    uint32 Unk0xDC[3] <hidden = true>;
} ProfileSummaryChrAsm;

typedef struct {
    wchar_t CharacterName[0x10];
    uint16 CharacterNameTerminator <hidden = true>;
    int32 Level;
    int32 SecondsPlayed;
    int32 RunesMemory;
    M MapId;
    uint32 PlaceNameId;     // PlaceName text id of the load screen location
    int32 FaceDataMarker <hidden = true>;
    FaceBlock Face(0x120);  // with face param overrides applied
    ProfileSummaryChrAsm Equipment;
    ubyte BodyType;
    ubyte ArcheType;
    ubyte StartingGift;
    ubyte unk0x245[7];
} ProfileData <read=Str("%03d | %s", Level, CharacterName)>;

typedef ubyte SlotState[10] <read=Str(
    "%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
    this[0],this[1],this[2],this[3],
    this[4],this[5],this[6],this[7],
    this[8],this[9]
)>;

typedef struct {
    SlotState IsProfileActive;
    ProfileData Profile[0xA] <optimize = false>;
} CSProfileSummary;

// PCOptionData (0xB2, PC only). Not the key bindings; purpose unknown.
typedef struct {
    uint16 Key;     // Windows virtual-key code
    uint16 Flag;    // 0 or 4
} PCOptionKey <read=Str("%02X / %d", Key, Flag)>;
typedef struct {
    ubyte Header[0x12];
    PCOptionKey Keys[40];
} CSPCOptionData;

// Key binding record, KeyAssignParam row order (26 rows)
typedef struct {
    int32 PadKey;           // -1 = none
    int32 KeyboardKey;
    int32 KeyboardModifier;
    int32 MouseKey;
    int32 MouseModifier;
} KeyBinding <read=Str("pad %d kb %d/%d mouse %d/%d", PadKey, KeyboardKey, KeyboardModifier, MouseKey, MouseModifier)>;

typedef struct {
    uint16 unk0x0;          // 0x1F
    uint16 unk0x2;          // 1
    uint32 Size <format = hex>;
    local int64 end = FTell() + Size;
    if (Size >= 0x211) {
        KeyBinding Bindings[26];
        ubyte MouseSensitivity;         // 0-10, default 5
        ubyte MouseXAxis;               // 1 normal, 0 reversed
        ubyte MouseYAxis;               // 1 normal, 0 reversed
        ubyte MapMenuCursorMovement;    // 1 keyboard and mouse, 0 keyboard only
        ubyte TargetChangeSensitivity;  // default 1
        ubyte unk0x20d[3] <hidden = true>;
        ubyte OnScreenPromptDevice;     // 0 gamepad, 1 keyboard and mouse
    }
    if (FTell() < end)
        ubyte Unused[end - FTell()] <hidden = true>;
} CSKeyConfigSaveLoad;

typedef struct (int isPS) {
    local int64 start = FTell();
    if (!isPS)
        ubyte Checksum[0x10] <format = hex>;
    local int64 end = FTell() + 0x60000;
    uint32 Version;
    uint64 SteamId;
    CSSettings Settings;
    CSMenuSystemSaveLoad MenuSystemSaveLoad;
    CSProfileSummary ProfileSummary;
    ubyte GameManBytes[5];
    if (!isPS)
        CSPCOptionData PCOptionData;
    CSKeyConfigSaveLoad KeyConfigSaveLoad;
    uint64 GameDataMan0x118;
    // Leftover buffer content, no structure
    ubyte Remainder[end - FTell()] <hidden = true>;
} USER_DATA10;

typedef char RegMagic[4] <read=Str("%c%c%c%c", this[3], this[2], this[1], this[0])>;
typedef struct (int isPS) {
    if (!isPS)
        ubyte Checksum[0x10] <format = hex>;
    RegMagic Magic;
    uint32 unk0x4 <format = hex>;
    uint32 Version <format = hex>;
    uint32 Size <format = hex>;
    ubyte Regulation[0x240000];
} USER_DATA11;

//------------------------------------------------
// File
//------------------------------------------------

typedef struct {
    uint32 Flags <format = hex>;
    int32 unk0x4;
    uint64 EntrySize <format = hex>;
    uint32 DataOffset <format = hex>;
    uint32 NameOffset <format = hex>;
    uint64 unk0x18;
} BND4Entry;

typedef struct {
    char Magic[4];
    ubyte unk0x4[4];
    ubyte BigEndian;
    ubyte unk0x9[3];
    uint32 FileCount;
    uint64 HeaderSize <format = hex>;
    char VersionString[8];
    uint64 EntryHeaderSize <format = hex>;
    uint64 DataStart <format = hex>;
    ubyte Unicode;
    ubyte unk0x31[0xF];
    BND4Entry Entries[FileCount];
    ubyte Names[DataStart - FTell()];
} BND4FileHeader;

local int IsPS = (ReadUInt(0) == 0x2C9C01CB);
local int k;

if (IsPS) {
    ubyte PSHeader[0x70];
    for (k = 0; k < 10; k++) {
        FSeek(0x70 + k * 0x280000);
        Slot Character(0);
    }
    FSeek(0x70 + 10 * 0x280000);
    USER_DATA10 Common(1);
    if (FileSize() - FTell() >= 0x240010)
        USER_DATA11 Regulation(1);
} else {
    BND4FileHeader Header;
    for (k = 0; k < 10; k++) {
        FSeek(Header.Entries[k].DataOffset);
        Slot Character(1);
    }
    FSeek(Header.Entries[10].DataOffset);
    USER_DATA10 Common(0);
    FSeek(Header.Entries[11].DataOffset);
    USER_DATA11 Regulation(0);
}
